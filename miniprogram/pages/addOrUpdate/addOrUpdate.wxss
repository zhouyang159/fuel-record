.add-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #f4f6f7;
  padding: 24rpx;
}

.car-name {
  color: #34414d;
  font-size: 28rpx;
  font-weight: 600;
  margin: 0 8rpx 18rpx;
}

.card {
  background: #ffffff;
  border-radius: 8rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 41, 51, 0.08);
  padding: 24rpx;
}

.save-wrap {
  margin-top: 28rpx;
  display: flex;
}

.save-wrap van-button {
  flex: 1;
}
