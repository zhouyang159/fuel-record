
<view class="record-form">
  <view class="form-section">
    <view class="section-title">加油信息</view>
    <view class="date-time-row">
      <picker class="picker-field" mode="date" value="{{record.date}}" bindchange="onDateChange">
        <text class="field-label">日期</text>
        <text class="picker-value">{{record.date}}</text>
      </picker>
      <picker class="picker-field" mode="time" value="{{record.time}}" bindchange="onTimeChange">
        <text class="field-label">时间</text>
        <text class="picker-value">{{record.time}}</text>
      </picker>
    </view>
    <view class="input-field mileage-field" bindtap="focusField" data-field="mileage">
      <text class="field-label">当前里程</text>
      <input class="input" value="{{record.mileage}}" type="number" placeholder="请输入当前公里数" focus="{{focusedField === 'mileage'}}" bindinput="onMileageChange" bindblur="clearFocusedField" />
      <text class="field-unit">公里</text>
    </view>
  </view>

  <view class="form-section">
    <view class="section-title">本次加油</view>
    <view class="number-grid">
      <view class="input-field" bindtap="focusField" data-field="price">
        <text class="field-label">机显单价</text>
        <input class="input" value="{{record.price}}" type="digit" placeholder="0.00" focus="{{focusedField === 'price'}}" bindinput="onPriceChange" bindblur="clearFocusedField" />
        <text class="field-unit">元/升</text>
      </view>
      <view class="input-field" bindtap="focusField" data-field="quantity">
        <text class="field-label">加油量</text>
        <input class="input" value="{{record.quantity}}" type="digit" placeholder="0.00" focus="{{focusedField === 'quantity'}}" bindinput="onQuantityChange" bindblur="clearFocusedField" />
        <text class="field-unit">升</text>
      </view>
      <view class="input-field" bindtap="focusField" data-field="pay">
        <text class="field-label">机显金额</text>
        <input class="input" value="{{record.pay}}" type="digit" placeholder="0.00" focus="{{focusedField === 'pay'}}" bindinput="onPayChange" bindblur="clearFocusedField" />
        <text class="field-unit">元</text>
      </view>
    </view>
  </view>

  <view class="form-section">
    <view class="section-title">优惠与实付</view>
    <view class="number-grid">
      <view class="input-field calculated-field">
        <text class="field-label">实际单价</text>
        <input class="input disabled" disabled="{{true}}" value="{{record.realPrice}}" type="digit" />
        <text class="field-unit">元/升</text>
      </view>
      <view class="input-field" bindtap="focusField" data-field="discountAmount">
        <text class="field-label">优惠金额</text>
        <input class="input" value="{{record.discountAmount}}" type="digit" placeholder="0.00" focus="{{focusedField === 'discountAmount'}}" bindinput="onDiscountAmountChange" bindblur="clearFocusedField" />
        <text class="field-unit">元</text>
      </view>
      <view class="input-field" bindtap="focusField" data-field="realPay">
        <text class="field-label">实付金额</text>
        <input class="input" value="{{record.realPay}}" type="digit" placeholder="0.00" focus="{{focusedField === 'realPay'}}" bindinput="onRealPayChange" bindblur="clearFocusedField" />
        <text class="field-unit">元</text>
      </view>
    </view>
  </view>

  <view class="form-section toggle-section">
    <view class="toggle-row">
      <text class="toggle-label">本次是否加满</text>
      <view class="segmented-control">
        <view class="segment {{record.isAddFull ? 'segment-active' : ''}}" bindtap="setAddFull" data-value="true">加满</view>
        <view class="segment {{!record.isAddFull ? 'segment-active' : ''}}" bindtap="setAddFull" data-value="false">未加满</view>
      </view>
    </view>
    <view class="toggle-row">
      <text class="toggle-label">油量警告灯</text>
      <view class="segmented-control">
        <view class="segment {{record.isWarningLight ? 'segment-active' : ''}}" bindtap="setWarningLight" data-value="true">已亮</view>
        <view class="segment {{!record.isWarningLight ? 'segment-active' : ''}}" bindtap="setWarningLight" data-value="false">未亮</view>
      </view>
    </view>
  </view>
</view>