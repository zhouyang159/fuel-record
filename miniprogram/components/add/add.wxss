.record-form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.form-section {
  background: #ffffff;
}

.section-title {
  color: #1f2933;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.date-time-row,
.number-grid {
  display: flex;
  gap: 14rpx;
}

.picker-field,
.input-field {
  box-sizing: border-box;
  border: 1rpx solid #dce3e8;
  border-radius: 8rpx;
  min-height: 104rpx;
  padding: 14rpx 16rpx;
  background: #ffffff;
}

.picker-field {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.field-label {
  color: #68737d;
  font-size: 26rpx;
  line-height: 1.3;
}

.picker-value {
  color: #18212b;
  font-size: 32rpx;
  margin-top: 6rpx;
}

.mileage-field {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}

.mileage-field .field-label {
  width: 118rpx;
}

.number-grid .input-field {
  flex: 1;
  min-width: 0;
}

.input {
  color: #18212b;
  font-size: 32rpx;
  height: 44rpx;
  line-height: 44rpx;
  margin-top: 6rpx;
  min-width: 0;
}

.field-unit {
  color: #94a0aa;
  font-size: 24rpx;
  margin-top: 3rpx;
}

.mileage-field .input {
  flex: 1;
  margin: 0 10rpx 0 0;
  text-align: right;
}

.calculated-field {
  background: #f4f6f7;
}

.input.disabled {
  color: #75808a;
}

.toggle-section {
  border-top: 1rpx solid #edf0f2;
  padding-top: 8rpx;
}

.toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 84rpx;
}

.toggle-label {
  color: #34414d;
  font-size: 30rpx;
}

.segmented-control {
  display: flex;
  background: #f1f4f5;
  border-radius: 8rpx;
  padding: 4rpx;
}

.segment {
  box-sizing: border-box;
  color: #68737d;
  font-size: 28rpx;
  min-width: 104rpx;
  padding: 12rpx 14rpx;
  text-align: center;
}

.segment-active {
  background: #1c8c70;
  border-radius: 6rpx;
  color: #ffffff;
  font-weight: 600;
}